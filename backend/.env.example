PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173

# [선택] 실제 이메일(Gmail 또는 네이버)로 발송하고 싶을 때 아래 주석을 해제하고 입력하세요.
# 미입력 시에도 무료 테스트 메일함(Ethereal SMTP)이 자동 생성되어 브라우저에서 실제 발송된 이메일을 바로 열어볼 수 있습니다!
# SMTP_SERVICE=gmail
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_digit_gmail_app_password
