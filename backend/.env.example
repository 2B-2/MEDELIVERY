PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173

# ====================================================================
# [1. AWS RDS for MySQL (또는 로컬 MySQL) 설정]
# - 아래 DB_HOST를 입력하지 않으면(주석 유지 시) 별도 DB 설치 없이도 로컬 파일(.medelivery-data.json)로 자동 저장 및 동작합니다!
# - 나중에 AWS RDS(MySQL) 생성 후 아래 4줄의 주석을 풀고 엔드포인트 주소를 입력하면,
#   서버 시작 시 자동으로 medelivery DB와 schema.sql의 5개 테이블을 생성하고 MySQL과 실시간 동기화됩니다!
# ====================================================================
# DB_HOST=medelivery-db.xxxxxxxxxxxx.ap-northeast-2.rds.amazonaws.com
# DB_PORT=3306
# DB_USER=admin
# DB_PASSWORD=your_rds_master_password
# DB_NAME=medelivery

# ====================================================================
# [2. 실제 이메일(Gmail / 네이버) 자동 발송 설정 (Nodemailer)]
# ====================================================================
# SMTP_SERVICE=naver
# SMTP_USER=your_email@naver.com
# SMTP_PASS=your_password_or_app_password

# ====================================================================
# [3. AI 자서전 LLM API 설정 (추후 AI 담당 팀원이 입력)]
# ====================================================================
# GEMINI_API_KEY=your_google_gemini_api_key
